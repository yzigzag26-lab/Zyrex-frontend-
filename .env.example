# ---------------------------------------------------------------------------
# ZYREX AI — backend connection
# Copy to `.env` (git-ignored) and adjust. Every value below has a working
# default baked into src/lib/zyrexApi.ts, so an empty `.env` is fine.
# ---------------------------------------------------------------------------

# Backend origin: scheme + host, NO api path.
# Default: https://zyrex-backend-obafemip715.wasmer.app
# For a local Node server use http://localhost:3001
VITE_API_BASE_URL=https://zyrex-backend-obafemip715.wasmer.app

# Path that returns an AI answer for a prompt. Default: /api/zyrex-ai
VITE_AI_ENDPOINT=/api/zyrex-ai

# Path used for the reachability probe shown in Settings / chat header.
# Default: /api/health
VITE_HEALTH_ENDPOINT=/api/health

# How long to wait for an answer before giving up (ms). Default: 30000
VITE_AI_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Dev proxy — on by default during `npm run dev`.
#
# The backend only answers browsers whose Origin is in its CORS_ORIGINS list
# (currently https://zyrex.vercel.app and https://zyrex.wasmer.app). Any other
# origin, including localhost and preview hostnames, is rejected by CORS before
# any JSON can be read.
#
#   true  → the browser calls a relative /api path on the Vite dev server,
#           which forwards it to VITE_API_BASE_URL. Same-origin: no CORS.
#   false → the browser calls VITE_API_BASE_URL directly. Only works if this
#           origin is in the backend's CORS_ORIGINS.
#
# Set to false when the frontend is deployed at an allow-listed origin.
# ---------------------------------------------------------------------------
VITE_USE_DEV_PROXY=true

# ---------------------------------------------------------------------------
# Production same-origin proxy — the CORS escape hatch.
#
# GET /api/health succeeding does NOT prove a POST preflight will pass. Until
# the backend's CORS fix is live, the only client-side way through is to never
# make a cross-origin call:
#
#   1. Deploy on Vercel (vercel.json rewrites /api/* to the backend).
#   2. Build with VITE_USE_PROXY=true so the browser calls relative /api paths.
#
# Leave unset (or false) when this origin is already in CORS_ORIGINS.
# ---------------------------------------------------------------------------
# VITE_USE_PROXY=true
