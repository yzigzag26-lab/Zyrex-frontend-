# ---------------------------------------------------------------------------
# ZYREX AI — backend connection
# Copy to `.env` (git-ignored) and adjust. Every value below has a working
# default baked into src/lib/zyrexApi.ts, so an empty `.env` is fine.
# ---------------------------------------------------------------------------

# Backend origin. Default: https://zyrex-backend-obafemip715.wasmer.app
VITE_API_URL=https://zyrex-backend-obafemip715.wasmer.app

# Path that returns an AI answer for a prompt. Default: /api/zyrex-ai
VITE_AI_ENDPOINT=/api/zyrex-ai

# Path used for the reachability probe shown in Settings / chat header.
# Default: /api/health
VITE_HEALTH_ENDPOINT=/api/health

# How long to wait for an answer before giving up (ms). Default: 30000
VITE_AI_TIMEOUT_MS=30000

# Set to "true" if the backend does not send CORS headers. Requests then go to
# the Vite dev server, which forwards them to VITE_API_URL.
# Only affects `npm run dev`. Default: false
VITE_USE_DEV_PROXY=false
